{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "store:default",
    "sql:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.torbox.app/**" }
      ]
    }
  ]
}
